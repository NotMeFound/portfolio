# Copy this file to .env and fill in real values.
# .env itself must NEVER be committed to git — it's already in .gitignore.

# --- Database -----------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tu_portfolio_db
DB_USER=portfolio_app_user
DB_PASS=change_me_to_a_strong_password

# --- SMTP (Gmail example) ------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_USERNAME=your_gmail_address@gmail.com
# Generate at https://myaccount.google.com/apppasswords — NOT your real password.
SMTP_APP_PASSWORD=tsgx dykp jysd ybhp

# --- Mail envelope --------------------------------------------------------
MAIL_FROM_ADDRESS=your_gmail_address@gmail.com
MAIL_FROM_NAME="Portfolio Contact Form"
MAIL_TO_ADDRESS=your_gmail_address@gmail.com
