# ═══════════════════════════════════════════════
#  KARAN OLI PORTFOLIO — .htaccess
#  Apache config: security headers, clean URLs,
#  PHP file protection, GZIP, cache control.
# ═══════════════════════════════════════════════

Options -Indexes
Options -MultiViews

# ── Rewrite engine ──────────────────────────────────────────
RewriteEngine On
RewriteBase /

# Force HTTPS (uncomment in production)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Block direct access to PHP files in /php/ folder
# (they should only be called via AJAX from the front-end)
RewriteRule ^php/config\.php$ - [F,L]

# ── Security headers ─────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ── GZIP compression ─────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
  AddOutputFilterByType DEFLATE application/json text/plain
</IfModule>

# ── Browser cache control ─────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css              "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg            "access plus 3 months"
  ExpiresByType image/png             "access plus 3 months"
  ExpiresByType image/svg+xml         "access plus 3 months"
  ExpiresByType application/pdf       "access plus 1 week"
</IfModule>

# ── Block common attack patterns ─────────────────────────────
<IfModule mod_rewrite.c>
  RewriteCond %{QUERY_STRING} (;|<|>|'|"|\)|%0A|%0D|%22|%27|%3C|%3E|%00) [NC,OR]
  RewriteCond %{QUERY_STRING} (union|select|insert|drop|delete|update|cast|create|char|convert|alter|declare|script|set\+|md5|benchmark|or\+1) [NC]
  RewriteRule .* - [F]
</IfModule>
